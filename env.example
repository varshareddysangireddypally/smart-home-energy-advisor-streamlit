# ─────────────────────────────────────────────────────────────
#  Smart Home Energy Advisor Agent — Environment Configuration
#  IBM Cloud Lite + IBM Granite AI (watsonx.ai)
# ─────────────────────────────────────────────────────────────

# ── IBM watsonx.ai Credentials ───────────────────────────────
# Obtain from: https://cloud.ibm.com → Resources → watsonx.ai
IBM_WATSONX_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Granite Model ID ─────────────────────────────────────
# Available on IBM Cloud Lite (free tier)
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── Energy / Utility Settings ────────────────────────────────
# Cost per kWh in your local currency (e.g. USD cents)
ENERGY_RATE_PER_KWH=0.12
ENERGY_CURRENCY=USD

# Peak hours (24h format, comma-separated ranges)
PEAK_HOURS_START=17
PEAK_HOURS_END=21
OFF_PEAK_HOURS_START=22
OFF_PEAK_HOURS_END=6

# Peak / off-peak rate multipliers
PEAK_RATE_MULTIPLIER=1.5
OFF_PEAK_RATE_MULTIPLIER=0.7

# ── Smart Meter Settings ─────────────────────────────────────
# Meter ID for simulation / real integration
SMART_METER_ID=SM-HOME-001
HOUSEHOLD_SIZE=4
HOME_AREA_SQFT=1800

# ── Application Settings ─────────────────────────────────────
LOG_LEVEL=INFO
MAX_HISTORY_DAYS=30
AGENT_MAX_ITERATIONS=10
DEBUG_MODE=False
